# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Neon Postgres (usage, feedback, subscribers) ─────────────────────────────
# Server-only connection string for public.page_views, public.entitlements,
# public.feedback, and public.subscribers. Prefer the pooled Neon host.
# If this is unset, page-view and entitlement writes no-op and /admin shows
# not connected. Feedback and subscriber submissions return an error instead
# of writing. Do not point this at Supabase. A URL containing the empire-hq
# project ref radlwbqfzrzmgdldyifi is rejected the same way.
USAGE_DATABASE_URL=

# ── Supabase (legacy rows only) ───────────────────────────────────────────────
# Not used for new feedback, subscribers, page views, entitlements, or auth.
# Old rows stay where they are. This app does not read or copy them.
# Auth stays on Clerk.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public support address. Leave unset to use NEXT_PUBLIC_CONTACT_EMAIL,
# then admin@abcofcyber.com.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Comma-separated emails allowed to open /admin. No default.
USAGE_ADMIN_EMAILS=

# n8n feedback webhook shared secret (server-only; never NEXT_PUBLIC_).
# Sent as X-KD7-Secret after a feedback save. If unset, the webhook is still
# called without the header.
KD7_WEBHOOK_SECRET=
