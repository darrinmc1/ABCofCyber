# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (entitlements) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public support address. Leave unset to omit it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# n8n feedback webhook shared secret (server-only; never NEXT_PUBLIC_).
# Sent as X-KD7-Secret after a feedback save. If unset, the webhook is still
# called without the header.
KD7_WEBHOOK_SECRET=
