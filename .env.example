# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (entitlements) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (TTPN test mode — leave both flags false until Preview is checked) ──
# Server gate. POST /api/checkout and POST /api/stripe/webhook return 503 unless
# this AND NEXT_PUBLIC_STRIPE_ENABLED are the string true.
STRIPE_ENABLED=false
# Baked into the client at build time. Buy buttons stay "Coming soon" unless this is the string true.
# A product with available: false stays "Coming soon" even when this is true.
NEXT_PUBLIC_STRIPE_ENABLED=false
# TTPN test secret (sk_test_… or a restricted rk_test_…). Never commit the value.
STRIPE_SECRET_KEY=
# Signing secret for this site's test webhook endpoint. Never commit the value.
STRIPE_WEBHOOK_SECRET=
# Lookup-key prefix. Code builds abcofcyber_early_adopter_month_usd5,
# abcofcyber_pro_month_usd10, and abcofcyber_whats_the_play_month_usd29.
# Currency is usd.
STRIPE_SITE_KEY=abcofcyber
# Prebuilt Checkout does not need a publishable key. Leave blank unless a client SDK is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Launch offer (50% off the first billing period) ───────────────────────────
# YYYY-MM-DD. Active through 23:59:00 that day in Australia/Brisbane (UTC+10).
# Default end: 2026-12-18T23:59:00+10:00. Copy and checkout share one check.
# The label is shown only when both payment flags are true and this window is open.
# Extend by changing the date. Stripe redeem_by cannot be edited, so a longer run
# needs a new coupon or promotion code as well.
LAUNCH_OFFER_ENDS=2026-12-18
# Coupon id, or a promotion code id that starts with promo_.
# Create the coupon in Stripe test mode with duration "once" (first period only).
# This app does not create the coupon. Leave blank to charge the list price.
# An expired or missing coupon is dropped and checkout retries at list price.
STRIPE_LAUNCH_COUPON_ID=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public support address for the buy line. Leave unset to omit it.
NEXT_PUBLIC_SUPPORT_EMAIL=
